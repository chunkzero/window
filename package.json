{
  "name": "window-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check:ts": "tsc -p plugin && tsc -p plugin/test",
