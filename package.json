    "golden": "node scripts/golden.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "oxc-transform": "0.153.0",
    "oxfmt": "0.67.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
