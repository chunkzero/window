{
  "schemaVersion": 1,
  "id": "window-inspector",
  "version": "${version}",
  "name": "Window Render Inspector",
  "description": "Inspects Window resource packs through Minecraft's real client renderer.",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.oglass.window.inspector.WindowInspector"]
  },
  "mixins": ["window-inspector.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "=26.2",
    "java": ">=25"
  }
}
