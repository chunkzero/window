package window:compiler;

world window-compiler {
    record source-file {
        path: string,
        contents: list<u8>,
    }

    /// Generated text (JSON, Kotlin, shaders) crosses as a string; images as bytes.
    variant file-contents {
        text(string),
        binary(list<u8>),
    }

    record output-file {
        path: string,
        contents: file-contents,
    }

    /// Server API the generated Kotlin views and HUDs bind to.
    enum kotlin-target {
        agnostic,
        minestom,
        multistom,
    }

    record kotlin-options {
        package-name: string,
        target: kotlin-target,
    }

    record compile-output {
        files: list<output-file>,
        kotlin-files: list<output-file>,
        warnings: list<string>,
        /// The output size breakdown, present when `size.report` is set.
        size-report: option<string>,
    }

    export compile: func(
        namespace: string,
        project-json: string,
        files: list<source-file>,
        kotlin: option<kotlin-options>
    ) -> result<compile-output, string>;

    /// Renders the previews `previews-json` lists from the project `compile` takes. The files are not pack output.
    export render-previews: func(
        project-json: string,
        files: list<source-file>,
        previews-json: string
    ) -> result<list<output-file>, string>;
}
