package window:compiler;

world window-compiler {
    record source-file {
        path: string,
        contents: list<u8>,
    }

    record output-file {
        path: string,
        contents: list<u8>,
    }

    record compile-output {
        files: list<output-file>,
        kotlin-files: list<output-file>,
        warnings: list<string>,
        /// JSON objects to append to `pack.mcmeta` `overlays.entries`.
        pack-overlays: list<string>,
    }

    export compile: func(
        namespace: string,
        project-json: string,
        files: list<source-file>,
        kotlin-package: option<string>
    ) -> result<compile-output, string>;
}
